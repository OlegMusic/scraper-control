# ─────────────────────────────────────────────────────────────────────
# Scraper Control — собственные настройки
# ─────────────────────────────────────────────────────────────────────
SC_PORT=3100
LOG_DIR=./logs

# Путь к parser-firecrawl (его .env загружается ПЕРВЫМ — все API-ключи там)
PARSER_FIRECRAWL_DIR=C:/Users/prusi/Desktop/3. Проекты/proekte/parser-firecrawl

# Mongo connection — обычно совпадает с parser-firecrawl
MONGODB_URI=mongodb://localhost:27018/parser-firecrawl

# ─────────────────────────────────────────────────────────────────────
# API-ключи: ВСЕ ХРАНЯТСЯ В parser-firecrawl/.env (единый источник)
# ─────────────────────────────────────────────────────────────────────
# Эти переменные читаются автоматически из parser-firecrawl/.env при старте.
# Этот файл их перекрывает только если ты явно их здесь укажешь
# (полезно если хочешь использовать другую квоту для control-panel-инициированных
# запусков). По умолчанию — оставь пустыми.
#
# GOOGLE_PLACES_API_KEY=         — для google-places/ скрейперов
# YOUTUBE_API_KEY=               — для youtube-api-scan / youtube-deep-scan
# GEMINI_API_KEY=                — для qdrant-index v2 (semantic embeddings)
# FIRECRAWL_API_KEY=             — для scrape-hwk-firecrawl
# TIKTOK_CLIENT_KEY=             — для extract-telegram-tiktok / OAuth
# TIKTOK_CLIENT_SECRET=
#
# ─────────────────────────────────────────────────────────────────────
# Anthropic (только для Phase 2 — LLM-генератор скраперов)
# ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
